    {
      "id": "fan-out",
      "name": "Fan-out",
      "kind": "step",
      "description": "A lane per item. SPEC-MANIFEST.md §5.5. over must be exactly one placeholder resolving to an ARRAY. Mixed text returns nothing rather than guessing. If it does not resolve to an array, the step fails and says why. Each lane step sees its own item through {{item.…}} and {{index}}. Truncation is never silent. Without over, the lane is inlined and runs once, and the node says so rather than pretending to expand.",
      "input": {
        "over": {
          "type": "string",
          "required": false,
          "notes": "a single template resolving to an ARRAY, e.g. {{steps.Fetch feed.output.entries}}."
        },
        "maxItems": {
          "type": "number",
          "required": false,
          "notes": "cap. Default 50."
        },
        "then": {
          "type": "array",
          "required": true,
          "notes": "REQUIRED — the lane."
        }
      },
      "output": {
        "itemsFound": {
          "type": "number",
          "notes": "How many items the source held."
        },
        "itemsTaken": {
          "type": "number",
          "notes": "How many lanes were opened after the cap."
        },
        "stepsCreated": {
          "type": "number",
          "notes": "Lane steps created."
        },
        "truncated": {
          "type": "string",
          "notes": "A note when the cap cut the list. Never silent."
