{
  "schema": "qf.naming-inventory-allowlist/v1",
  "issue": "QF-NAMING-01",
  "classes": {
    "generic-control-flow": {
      "transitional": false,
      "meaning": "The built-in control-flow step kind loop (SPEC 5.7), not the product unit."
    },
    "generic-term": {
      "transitional": false,
      "meaning": "General programming or networking vocabulary."
    },
    "negative-guard": {
      "transitional": false,
      "meaning": "The retired name appears only so a guard or test can reject it."
    },
    "historical-immutable": {
      "transitional": false,
      "meaning": "Recorded evidence or provenance pinned to a past revision; rewriting it would falsify history."
    },
    "third-party": {
      "transitional": false,
      "meaning": "Another vendor's product name."
    },
    "historical-redacted": {
      "transitional": false,
      "meaning": "Recorded evidence published with a documented redaction (see its redactions field); remaining recorded values unchanged."
    }
  },
  "rules": [
    {
      "class": "generic-term",
      "path": "^README\\.md$",
      "token": "^loopback$",
      "reason": "authenticated loopback webhook trigger"
    },
    {
      "class": "generic-control-flow",
      "path": "^SPEC-MANIFEST\\.md$",
      "line": "Control flow|kind: loop|loop\\.maxIterations",
      "reason": "SPEC 5.7 control-flow kind",
      "token": "^(loop|`loop`|loop\\.maxIterations)$"
    },
    {
      "class": "generic-control-flow",
      "path": "^registry/README\\.md$",
      "line": "control-flow operators",
      "reason": "built-in control-flow component inventory",
      "token": "^loop$"
    },
    {
      "class": "generic-control-flow",
      "path": "^registry/(composition|catalog)\\.json$",
      "line": "\"id\": \"loop\"|if, switch, loop and each",
      "reason": "composition.builtins control-flow entry",
      "token": "^loop$"
    },
    {
      "class": "generic-control-flow",
      "path": "^src/(flatten|run|manifest)\\.mjs$",
      "line": "\"loop\"|a loop step",
      "reason": "engine control-flow kind",
      "token": "^loop$"
    },
    {
      "class": "generic-control-flow",
      "path": "^test/control-flow\\.test\\.mjs$",
      "reason": "control-flow kind tests"
    },
    {
      "class": "generic-control-flow",
      "path": "^test/q-workflow-cli-naming\\.test\\.mjs$",
      "line": "generic|kind: loop|loop\\\\s\\+repeat|loop\\.yaml",
      "reason": "CLI keeps the generic control-flow kind"
    },
    {
      "class": "negative-guard",
      "path": "^src/manifest\\.mjs$",
      "line": "family === \"qloops\\.loop\"",
      "reason": "manifest rejects the retired namespace fail-closed",
      "token": "^qloops\\.loop$"
    },
    {
      "class": "negative-guard",
      "path": "^scripts/(check-product-names|check-naming-inventory)\\.mjs$",
      "reason": "naming guards"
    },
    {
      "class": "negative-guard",
      "path": "^scripts/naming-inventory\\.allowlist\\.json$",
      "reason": "this classification"
    },
    {
      "class": "negative-guard",
      "path": "^test/(product-names|naming-inventory|registry-digest|record-proof-naming)\\.test\\.mjs$",
      "reason": "negative naming fixtures"
    },
    {
      "class": "negative-guard",
      "path": "^test/manifest\\.test\\.mjs$",
      "line": "qloops",
      "reason": "retired manifest namespace rejection test",
      "token": "^(qloops|qloops\\.loop|qloops\\.loop/v[12]|\\.loop)$"
    },
    {
      "class": "negative-guard",
      "path": "^(scripts/test-registry-export|test/q-workflow-cli-naming\\.test)\\.mjs$",
      "line": "doesNotMatch|retiredRenderedTerm",
      "reason": "asserts retired CLI output is absent"
    },
    {
      "class": "historical-immutable",
      "path": "^registry/catalog(\\.source)?\\.json$",
      "line": "\"path\": \"content/registry/loops/",
      "reason": "origin provenance path at 0design/QFactory.io revision e453b57",
      "token": "^content/registry/loops/[a-z0-9-]+\\.yaml$"
    },
    {
      "class": "third-party",
      "path": "^registry/demos/digest-huyiks\\.txt$",
      "token": "^Loops$",
      "reason": "Linear Loops, quoted in recorded digest output"
    },
    {
      "class": "historical-redacted",
      "path": "^registry/demos/sdd-verified-change\\.txt$",
      "line": "loopId|loopVersion|\"loops/",
      "token": "^(loopId|loopVersion|loops/[a-z0-9-]+(\\.yaml)?)$",
      "reason": "recorded Core16 SDD transcript; workspace path redacted 2026-09-25 (redactions field)"
    },
    {
      "class": "historical-immutable",
      "path": "^registry/demos/[a-z0-9-]+\\.txt$",
      "line": "loopId|loopVersion|\"loops/",
      "reason": "recorded 2026-09-19 Core16 acceptance transcript",
      "token": "^(loopId|loopVersion|loops/[a-z0-9-]+(\\.yaml)?)$"
    }
  ]
}
