{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qf.agent/v1/request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "requestId",
    "loop",
    "intent",
    "workspace",
    "allowedPaths",
    "allowedTools",
    "provider",
    "deadlineMs",
    "maxRepairAttempts",
    "verifier"
  ],
  "properties": {
    "protocolVersion": {
      "const": "qf.agent/v1"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[\\w-]{1,100}$"
    },
    "loop": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "enum": ["synthetic-sdd", "sdd-pipeline"]
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32000
    },
    "workspace": {
      "type": "string",
      "description": "Absolute trusted local directory"
    },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "allowedTools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provider": {
      "type": "object",
      "required": [
        "kind",
        "model",
        "payerScope"
      ],
      "properties": {
        "kind": {
          "enum": [
            "claude",
            "codex",
            "openrouter"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "payerScope": {
          "enum": [
            "local-cli",
            "local-byok"
          ]
        },
        "executable": {
          "type": "string"
        },
        "keyRef": {
          "type": "string"
        }
      }
    },
    "deadlineMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "maxRepairAttempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "verifier": {
      "type": "object",
      "required": [
        "command",
        "args"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "hash",
        "decision"
      ],
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decision": {
          "enum": [
            "approve",
            "reject"
          ]
        }
      }
    },
    "resumeRunId": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "maxCostUsd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maxCallCostUsd": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "description": "Structural schema. validateRequest additionally enforces local path, verifier authorization, provider pairing and bound relations."
}
