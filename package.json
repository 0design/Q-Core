{
  "name": "q-core",
  "version": "0.2.0-q-core.43",
  "license": "MIT",
  "description": "Run agent workflows end-to-end, without skipping instructions. The local engine behind QFactory: runs workflow YAML files on your machine, no database or server.",
  "type": "module",
  "bin": {
    "q-core": "bin/q-core.mjs",
    "q-core-host": "bin/q-core-host.mjs"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "catalog": "node -e \"import('./src/catalog.mjs').then(async({buildCatalog})=>{const{writeFileSync}=await import('node:fs');writeFileSync('catalog.json',JSON.stringify(buildCatalog('workflows',{examplesDir:'examples'}),null,2)+'\\n')})\"",
    "proof": "node scripts/record-proof.mjs --all",
    "check:public-surface": "node scripts/check-public-surface.mjs",
    "check:product-names": "node scripts/check-product-names.mjs",
    "check:naming-inventory": "node scripts/check-naming-inventory.mjs",
    "prepack": "npm run check:public-surface && npm run check:product-names",
    "test:registry-export": "node scripts/test-exact-registry-export.mjs",
    "test:package": "npm run check:public-surface && npm run check:product-names && node scripts/test-package.mjs && node scripts/test-content-package.mjs && npm run test:registry-export"
  },
  "files": [
    "bin/",
    "src/",
    "launchd/",
    "examples/",
    "LICENSE",
    "CONTRIBUTING.md",
    "README.md",
    "SPEC-MANIFEST.md",
    "contracts/",
    "docs/codex.md",
    "docs/secrets.md",
    "docs/cli-registry.md",
    "docs/reference.md"
  ],
  "dependencies": {},
  "author": "Oleg Kukharuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0design/Q-Core.git"
  },
  "bugs": {
    "url": "https://github.com/0design/Q-Core/issues"
  },
  "homepage": "https://github.com/0design/Q-Core#readme",
  "exports": {
    ".": "./src/index.mjs",
    "./src/*": "./src/*",
    "./contracts/*": "./contracts/*",
    "./package.json": "./package.json"
  }
}
